<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bag"
    tools:context=".chatWin">

    <!-- Top Chat Header -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/lightwhite"
        android:elevation="4dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/backbtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/backgo"
            android:padding="4dp" />

        <!-- Profile Image -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profilerg0"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/logo"
            android:layout_marginStart="10dp" />

        <!-- Name + Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/reciverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tech Coder"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/userStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="#00C853"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>


    <!-- Chat Messages List -->
   <androidx.recyclerview.widget.RecyclerView
       android:layout_width="match_parent"
       android:layout_height="502dp"
       android:id="@+id/msgadpter"
       android:layout_alignParentTop="true"
       android:layout_alignParentBottom="true"
       android:layout_marginTop="70dp"
       android:layout_marginBottom="70dp"
       android:padding="13dp"/>



    <!-- Bottom Message Typing Box -->
    <LinearLayout
        android:id="@+id/message_box"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/lightwhite"
        android:layout_alignParentBottom="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/emogi" />

        <EditText
            android:id="@+id/textmsg"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Message"
            android:paddingHorizontal="15dp"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/attach"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/sendbtnn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/send"
            android:padding="6dp"
            android:background="@drawable/send"
            app:tint="#FFFFFF" />

    </LinearLayout>

</RelativeLayout>
